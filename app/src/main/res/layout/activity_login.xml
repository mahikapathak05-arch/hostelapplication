
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F5FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/logo"
            android:contentDescription="HostelConnect Logo"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HostelConnect"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#453078" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Welcome back! Sign in to continue."
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your full name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="#6750A4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Login as"
            android:textColor="#333333"
            android:textStyle="bold"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/roleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/studentRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Student"
                android:textColor="#453078" />

            <RadioButton
                android:id="@+id/wardenRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Warden"
                android:textColor="#453078" />

        </RadioGroup>

        <EditText
            android:id="@+id/sapInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Enter your 11-digit SAP ID"
            android:inputType="number"
            android:maxLength="11"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="#6750A4" />

        <EditText
            android:id="@+id/wardenEmailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="warden@local"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="#6750A4"
            android:visibility="gone" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Enter your password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:backgroundTint="#6750A4" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="LOGIN"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6750A4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Student accounts can only be created by the administrator."
            android:textColor="#666666"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
